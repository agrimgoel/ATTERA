# Public (safe to expose to browser - Supabase anon key is designed for this,
# access is enforced by Row Level Security policies, not by secrecy)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET - server-side only. NEVER prefix with NEXT_PUBLIC_, never import in
# client components. Used only in API routes / the CLI import script to
# create logins and bypass RLS for admin operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by scripts/import-csv.mjs to know which project to write to
# (same as NEXT_PUBLIC_SUPABASE_URL, duplicated here for clarity when
# running the script standalone with `node -r dotenv/config`)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
